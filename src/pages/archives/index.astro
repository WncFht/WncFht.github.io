---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import { getPublishedPosts } from "@/utils/getPublishedPosts";
import { dateInTimezone } from "@/utils/datetime";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getPublishedPosts();
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });

// Archive by publication day in the post's timezone; updates affect the other lists, not archive groups.
const publishDate = (post: CollectionEntry<"posts">) =>
  dateInTimezone(
    post.data.pubDatetime,
    post.data.timezone ?? config.site.timezone
  );
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      [...Map.groupBy(posts, post => publishDate(post).year())]
        .sort(([yearA], [yearB]) => yearB - yearA)
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>{" "}
            <sup class="text-muted-foreground text-sm">{yearGroup.length}</sup>
            {[...Map.groupBy(yearGroup, post => publishDate(post).month() + 1)]
              .sort(([monthA], [monthB]) => monthB - monthA)
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(new Date(2000, month - 1, 1))}
                    </span>{" "}
                    <sup class="text-muted-foreground text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          b.data.pubDatetime.getTime() -
                          a.data.pubDatetime.getTime()
                      )
                      .map(data => (
                        <Card {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>
</Layout>
