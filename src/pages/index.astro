---
import CollectionCard from "@/components/CollectionCard.astro";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import { collections } from "@/data/collections";
import config from "@/config";
import { getPublishedPosts } from "@/utils/getPublishedPosts";

const posts = await getPublishedPosts();
---

<Layout>
  <main id="main-content" class="app-layout py-8 sm:py-12">
    <section class="border-border border-b pb-8">
      <p class="text-accent text-sm font-medium">研究笔记 / LLM / Agent</p>
      <h1 class="text-foreground mt-3 text-4xl font-bold sm:text-5xl">
        Haotian Fang
      </h1>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
        记录 LLM 训练、Agent 系统与具身智能方向的论文阅读、方法思考和实践。
      </p>
      <div class="mt-5 flex flex-wrap gap-4 text-sm">
        <a
          class="text-accent underline decoration-dashed underline-offset-4"
          href="/collections">浏览专题 →</a
        >
        <a
          class="text-accent underline decoration-dashed underline-offset-4"
          href="/publications">查看论文 →</a
        >
        <a
          class="text-accent underline decoration-dashed underline-offset-4"
          href="/about">了解我 →</a
        >
        <a
          class="text-accent underline decoration-dashed underline-offset-4"
          href="https://github.com/WncFht">GitHub ↗</a
        >
      </div>
    </section>

    <section class="border-border border-b py-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-foreground text-2xl font-semibold">专题</h2>
        <a class="text-accent text-sm" href="/collections">全部专题 →</a>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          collections.map(collection => (
            <CollectionCard collection={collection} heading="h3" />
          ))
        }
      </div>
    </section>

    <section class="border-border border-b py-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-foreground text-2xl font-semibold">最近文章</h2>
        <a class="text-accent text-sm" href="/posts">全部文章 →</a>
      </div>
      <ul class="divide-border mt-3 divide-y">
        {
          posts
            .slice(0, config.posts.perIndex)
            .map(post => <Card variant="h3" {...post} />)
        }
      </ul>
    </section>

    <section class="border-border mt-2 border-t py-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <div>
          <h2 class="text-foreground text-2xl font-semibold">关于这个站点</h2>
          <p class="text-muted-foreground mt-2">
            完整的个人介绍、研究经历和开源项目集中在 About 页面。
          </p>
        </div>
        <a class="text-accent text-sm" href="/about">查看 About →</a>
      </div>
    </section>
  </main>
</Layout>
