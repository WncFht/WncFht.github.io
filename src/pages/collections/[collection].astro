---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import { getPublishedPosts } from "@/utils/getPublishedPosts";
import { collections } from "@/data/collections";

export async function getStaticPaths() {
  return collections.map(collection => ({
    params: { collection: collection.id },
    props: { collection },
  }));
}

type Props = { collection: (typeof collections)[number] };
const { collection: meta } = Astro.props;
const posts = (await getPublishedPosts()).filter(
  post => post.data.collection === meta.id
);
---

<Layout title={meta.title} description={meta.description}>
  <main id="main-content" class="app-layout py-10">
    <header class="border-border border-b pb-6">
      <p class="text-accent text-sm font-medium">专题合集</p>
      <h1 class="text-foreground mt-2 text-3xl font-bold">{meta.title}</h1>
      <p class="text-muted-foreground mt-3">{meta.description}</p>
    </header>
    <ul class="divide-border divide-y">
      {posts.map(post => <Card variant="h3" {...post} />)}
    </ul>
  </main>
</Layout>
