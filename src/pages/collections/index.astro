---
import CollectionCard from "@/components/CollectionCard.astro";
import Layout from "@/layouts/Layout.astro";
import { collections } from "@/data/collections";
import { getPublishedPosts } from "@/utils/getPublishedPosts";

const posts = await getPublishedPosts();
const count = (id: string) =>
  posts.filter(post => post.data.collection === id).length;
---

<Layout title="专题合集" description="按研究方向浏览研究笔记与论文周报。">
  <main id="main-content" class="app-layout app-prose py-10">
    <h1>专题合集</h1>
    <div class="not-prose grid gap-4 sm:grid-cols-2">
      {
        collections.map(collection => (
          <CollectionCard
            collection={collection}
            count={count(collection.id)}
          />
        ))
      }
    </div>
  </main>
</Layout>
