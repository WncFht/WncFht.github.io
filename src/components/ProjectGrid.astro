---
import type { Project } from "@/data/profile";

const { projects } = Astro.props as { projects: Project[] };
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    projects.map(project => (
      <a
        class="border-border hover:border-accent group rounded border p-5 transition-colors"
        href={project.href}
        target="_blank"
        rel="noreferrer"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-foreground group-hover:text-accent text-lg font-semibold">
            {project.name}
          </h3>
          <span class="text-muted-foreground text-xs">{project.role}</span>
        </div>
        <p class="text-muted-foreground mt-3 leading-7">
          {project.description}
        </p>
      </a>
    ))
  }
</div>
