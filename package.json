{
  "name": "wncfht-github-io",
  "type": "module",
  "version": "7.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && node copy-pagefind.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:maintenance": "ruff check scripts && ruff format --check scripts",
    "check:docs": "python3 scripts/check_docs.py && python3 scripts/notes_guard.py --root . && python3 scripts/check_archive.py",
    "test:maintenance": "python3 -m unittest discover -s scripts/tests -v",
    "check": "npm run lint && npm run format:check && npm run lint:md && npm run lint:maintenance && npm run check:docs && npm test && npm run test:maintenance && npm run build",
    "setup:maintenance": "python3 scripts/setup.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@khaister/expressive-code-word-wrap": "^1.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "astro-expressive-code": "^0.44.3",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "mermaid": "^12.3.0",
    "photoswipe": "^5.4.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "git-format-staged": "4.0.2",
    "markdownlint-cli2": "0.24.0",
    "pagefind": "^1.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "markdownlint": {
      "re2js": "2.8.7"
    }
  }
}
